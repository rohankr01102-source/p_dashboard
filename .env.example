# ==============================================================================
# Vocalytics AI — Docker Compose Environment Variables
# Copy this file to .env and fill in required values before running:
#   docker-compose up --build
# NEVER commit .env to version control.
# ==============================================================================

# MongoDB credentials (used by docker-compose.yml)
MONGO_USERNAME=vocalytics
MONGO_PASSWORD=CHANGE_ME_STRONG_MONGO_PASSWORD

# JWT Secret (also set in server/.env.production)
JWT_SECRET=CHANGE_ME_USE_A_SECURE_RANDOM_64_CHAR_STRING
