# ==============================================================================
# Vocalytics AI — Server Production Environment Variables
# Copy this file to .env.production and fill in all required values.
# NEVER commit the actual .env.production to version control.
# ==============================================================================

# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED: must be at least 64 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_SECURE_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# ─── Database ─────────────────────────────────────────────────────────────────
# In Docker Compose, use the service name: mongodb
MONGO_URI=mongodb://vocalytics:CHANGE_ME_MONGO_PASSWORD@mongodb:27017/vocalytics?authSource=admin

# ─── AI Microservice ──────────────────────────────────────────────────────────
# In Docker Compose, use the service name: ai-service
AI_SERVICE_URL=http://ai-service:8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=https://your-production-domain.com

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Max audio file size in bytes (default: 50MB)
# MAX_FILE_SIZE_BYTES=52428800
