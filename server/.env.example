# ============================================================
#  Vocalytics AI — Server Environment Configuration
#  Copy this file to .env and fill in all required values.
#  NEVER commit .env to version control.
# ============================================================

# ─── Application ────────────────────────────────────────────
NODE_ENV=development         # development | production | test
PORT=5000                    # HTTP server port

# ─── Database ───────────────────────────────────────────────
# MongoDB connection string (Atlas or self-hosted)
MONGO_URI=mongodb://localhost:27017/vocalytics

# ─── Authentication ──────────────────────────────────────────
# REQUIRED in production — must be a long, random secret (≥ 64 chars)
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d            # e.g. 1h | 7d | 30d

# ─── AI Microservice ─────────────────────────────────────────
# URL of the FastAPI audio analysis service
AI_SERVICE_URL=http://127.0.0.1:8000

# ─── File Uploads ─────────────────────────────────────────────
# Directory relative to project root for uploaded audio files
UPLOAD_DIR=uploads
# Max upload size in bytes (default: 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Express server
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Rate Limiting ───────────────────────────────────────────
# Override global request window and max if needed (optional)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=200

# ─── Logging ─────────────────────────────────────────────────
# Log level: error | warn | info | http | debug
LOG_LEVEL=info
# Log directory (relative to project root)
LOG_DIR=logs

# ─── Client / Next.js ────────────────────────────────────────
# Set these in client/.env.local — listed here for reference only
# NEXT_PUBLIC_API_URL=http://localhost:5000
